  </property>
  <property name="windowTitle">
   <string>MainWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* === Estilo general === */
QMainWindow {
    background-color: #f0f4f8;
    color: #2d3748;
    font-family: &quot;Segoe UI&quot;, &quot;SF Pro Display&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 14px;
    font-weight: 400;
}

/* === Frames === */
QFrame {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #99DFFF;
}

/* Barra superior */
#frame_superior {
    background-color: #ebf8ff;
    border: none;
    border-radius: 0px;
    border-bottom: 2px solid #90cdf4;
}

/* Panel lateral */
#frame_lateral {
    background-color: #f7fafc;
    border-right: 2px solid #bee3f8;
    border-radius: 0px;
}

/* Área principal */
#frame_paginas {
    background-color: #ffffff;
    border-radius: 0px;
}

/* === Botones === */
QPushButton {
    background-color: #00416B;
    color: #ffffff;
    border: 1px solid #3182ce;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 500;
    font-size: 24px;
    letter-spacing: 0.5px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2CC5E6, stop:1 #00416B);
}

QPushButton:hover {
    background-color: #3182ce;
    color: #ffffff;
    border: 1px solid #2c5aa0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4fa5f0, stop:1 #3182ce);
}

QPushButton:pressed {
    background-color: #2c5aa0;
    color: #ffffff;
    border: 1px solid #1e4a7e;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c5aa0, stop:1 #1e4a7e);
}

/* Botón principal (Menú) */
#boton_menu {
    background-color: #63b3ed;
    color: white;
    border: none;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #90cdf4, stop:1 #63b3ed);
}
#boton_menu:hover {
    background-color: #4299e1;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #63b3ed, stop:1 #4299e1);
}
#boton_menu:pressed {
    background-color: #3182ce;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4299e1, stop:1 #3182ce);
}

/* Botón salir */
#boton_salir {
    background-color: #FD5E5E;
    color: white;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FC8D9B, stop:1 #CC0520);
}
#boton_salir:hover {
    background-color: #f56565;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f56565, stop:1 #e53e3e);
}
#boton_salir:pressed {
    background-color: #e53e3e;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e53e3e, stop:1 #c53030);
}

/* === Campos de texto === */
QLineEdit {
    background-color: #ffffff;
    color: #2d3748;
    border: 1px solid #99DFFF;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 400;
    selection-background-color: #bee3f8;
}

QLineEdit:focus {
    border: 1px solid #63b3ed;
    background-color: #f7fafc;
    box-shadow: 0px 0px 5px rgba(99, 179, 237, 0.3);
}

QLineEdit:placeholder {
    color: #a0aec0;
}

/* === Labels === */
QLabel {
    color: #4a5568;
    font-weight: 500;
    font-size: 14px;
	border: none;
}

/* Label inferior o secundario */
#label_3 {
    color: #718096;
    font-size: 40px;
}

/* === Stacked Widget === */
QStackedWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

/* === Scrollbars === */
QScrollBar:vertical {
    border: none;
    background: #edf2f7;
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #90cdf4;
    min-height: 25px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #63b3ed;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #edf2f7;
    height: 12px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #90cdf4;
    min-width: 25px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #63b3ed;
}

/* === Layouts === */
QVBoxLayout, QHBoxLayout {
    spacing: 12px;
}

/* === Botones laterales === */
#boton_agregar, #boton_buscar, #boton_actualizar, #boton_eliminar, #boton_consultar {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    color: #4a5568;
    font-weight: 500;
    font-size: 14px;
    text-align: left;
    padding: 12px 16px;
}

#boton_agregar:hover, 
#boton_buscar:hover, 
#boton_actualizar:hover, 
#boton_eliminar:hover,
#boton_consultar:hover {
    background-color: #ebf8ff;
    border: 1px solid #90cdf4;
    color: #2c5aa0;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ebf8ff, stop:1 #bee3f8);
}

#boton_agregar:pressed, 
#boton_buscar:pressed, 
#boton_actualizar:pressed, 
#boton_eliminar:pressed,
#boton_consultar:pressed {
    background-color: #bee3f8;
    border: 1px solid #63b3ed;
    color: #1e4a7e;
}

/* === Tooltips === */
QToolTip {
    background-color: #ffffff;
    color: #2d3748;
    border: 1px solid #90cdf4;
    padding: 8px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
}

/* === Tablas === */
QTableWidget {
    background-color: #ffffff;
    color: #2d3748;
    gridline-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 400;
    selection-background-color: #bee3f8;
    selection-color: #2d3748;
    alternate-background-color: #f7fafc;
}

QHeaderView::section {
    background-color: #ebf8ff;
    color: #2c5aa0;
    border: 1px solid #bee3f8;
    border-radius: 4px;
    font-weight: 600;
    font-size: 13px;
    padding: 8px;
}

QHeaderView::section:hover {
    background-color: #bee3f8;
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #90cdf4;
    color: #1a365d;
}

/* Efectos adicionales para profundidad */
#frame_superior {
    border-bottom: 2px solid #90cdf4;
}

#frame_lateral {
    border-right: 2px solid #bee3f8;
}

/* Efectos de sombra suaves */
QFrame {
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.05);
}

QPushButton {
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

QLineEdit:focus {
    box-shadow: 0px 0px 8px rgba(99, 179, 237, 0.2);
}</string>
